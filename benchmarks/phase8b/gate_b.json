      "unknown_policy": "full_suite",
      "critical_policy": "not_applicable",
      "case_specific_rules_forbidden": true
    },
    {
      "id": "static_component_v1",
      "kind": "static",
      "implementation_ref": "benchmarks/phase8b/methods.py#static_component_v1",
      "visible_inputs": ["production_diff", "behavior_catalog", "method_config"],
      "unknown_policy": "widen_or_review",
      "critical_policy": "all_critical",
      "case_specific_rules_forbidden": true
    },
    {
      "id": "path_rules_v1",
      "kind": "static",
      "implementation_ref": "benchmarks/phase8b/methods.py#path_rules_v1",
      "visible_inputs": ["production_diff", "behavior_catalog", "method_config"],
      "unknown_policy": "widen_or_review",
      "critical_policy": "all_critical",
      "case_specific_rules_forbidden": true
    },
    {
      "id": "lexical_surface_v1",
      "kind": "static",
      "implementation_ref": "benchmarks/phase8b/methods.py#lexical_surface_v1",
      "visible_inputs": ["production_diff", "behavior_catalog", "method_config"],
      "unknown_policy": "widen_or_review",
      "critical_policy": "all_critical",
      "case_specific_rules_forbidden": true
    },
    {
      "id": "proofdiff_v0_1_0",
      "kind": "released",
      "implementation_ref": "src/proofdiff/engine/selector.py#select_contracts via benchmarks/phase8b/methods.py#proofdiff_v0_1_0",
      "visible_inputs": ["production_diff", "behavior_catalog", "method_config"],
      "unknown_policy": "widen_high_critical_smoke",
      "critical_policy": "released_selector",
      "case_specific_rules_forbidden": true
    }
  ],
  "candidate_edge_classes": [
    "declared_semantic",
    "static_program",
    "dynamic_trace",
    "historical_evidence",
    "critical_invariant"
  ],
  "scoring": {
    "safety": {
      "false_safe_critical_max": 0,
      "critical_recall_min": 1.0,
      "high_critical_recall_delta_vs_strongest_safe_static_min": 0.0
    },
    "selectivity": {
      "primary_metric": "excess_selection",
      "headline_excess_reduction_vs_strongest_safe_static_min": 0.25,
      "minimum_repository_wins": 3,
      "repository_win_excess_reduction_min": 0.15,
      "minimum_family_wins": 5,
      "family_balanced": true
    },
    "auditability": {
      "skip_proof_completeness_min": 1.0,
      "required_skip_proof_fields": [
        "changed_source_nodes",
        "candidate_behavior_node",
        "edge_classes_considered",
        "no_path_reason",
        "uncertainty_state",
        "calibration_freshness",
        "policy_attribution"
      ],
      "invalid_proof_policy": "widen_or_review"
    }
  },
  "maintenance_ledger": {
    "primary_metric": "manual_interventions",
    "candidate_vs_strongest_safe_static_max_ratio": 1.0,
    "counted_actions": [
      "initial_manual_mapping_entry",
      "case_specific_exception",
      "calibration_repair",
      "stale_mapping_repair",
      "human_approval_of_mapping_change"
    ],
    "time_policy": "report_only_if_measured",
    "secondary_metrics": [
      "manual_mapping_entries",
      "machine_derived_edges",
      "rule_or_graph_bytes",
      "calibration_updates",
      "review_actions"
    ]
  },
  "kill_rules": {
    "safety_failure": "kill_or_narrow_big",
    "static_pareto_dominance": "kill_or_narrow_big",
    "differentiation_threshold_failure": "no_differentiation_claim",
    "post_observation_tuning": "invalid_experiment"
  }

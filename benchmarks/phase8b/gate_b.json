  "anti_leakage": {
    "candidate_network_access": false,
    "candidate_benchmark_repo_access": false,
    "candidate_git_metadata_access": false,
    "candidate_visible": [
      "repo",
      "base_sha",
      "head_sha",
      "sanitized_baseline_source",
      "sanitized_candidate_source",
      "production_diff",
      "behavior_catalog",
      "method_config"
    ],
    "evaluator_only": [
      "case_id",
      "family_id",
      "criticality",
      "confounding_risk",
      "protected_invariants",
      "oracle",
      "ground_truth_behavior_ids",
      "source_url",
      "pr_number",
      "upstream_reference",
      "discrimination_reason",
      "notes",
      "case_title"
    ],
    "forbidden_case_prose": [
      "source_url",
      "upstream_reference",
      "title",
      "discrimination_reason",
      "notes",
      "oracle.paths",
      "oracle.tests",
      "oracle.notes"
    ],
    "source_snapshot_exclusions": [
      ".git/**",
      ".github/**",
      "docs/**",
      "documentation/**",
      "examples/**",
      "benchmarks/**",
      "test/**",
      "tests/**",
      "**/test/**",
      "**/tests/**",
      "**/test_*.py",
      "**/*_test.py",
      "**/*.snap",
      "CHANGELOG*",
      "RELEASE*"
    ],
    "behavior_universe_derivation": {
      "scope": "repository_union",
      "source_field": "protected_invariants",
      "stable_id": "sha256(repo + NUL + normalized_invariant_utf8)[:20]",
      "case_association_removed": true,
      "deduplicate_normalized_text": true
    }
  },
  "methods": [

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TensorScholar/proofdiff/schemas/manifest.schema.json",
  "title": "ProofDiff Agent Manifest",
  "type": "object",
  "required": ["agent", "runtime", "tools"],
  "properties": {
    "agent": {"type": "object"},
    "runtime": {"type": "object"},
    "instructions": {},
    "tools": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["name", "input_schema"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          },
          "description": {"type": "string"},
          "input_schema": {"type": "object"},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "destructive": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "mcp": {"type": "object"},
    "policy": {"type": "object"},
    "retrieval": {"type": "object"},
    "source": {"type": "object"},
    "environment": {"type": "object"}
  },
  "additionalProperties": true
}
